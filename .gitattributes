* text=auto

# Always use LF for executable scripts
*.sh text eol=lf

# Keep common source/config files normalized with LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.css text eol=lf

# PDFs are compressed binary artifacts; never normalize or render them as text diffs.
*.pdf binary
