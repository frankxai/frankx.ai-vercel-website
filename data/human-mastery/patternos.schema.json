{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/human-mastery/patternos-v0.2.schema.json",
  "title": "Human Mastery PatternOS v0",
  "description": "Structural contract for the five-plane capability graph, Pattern Intelligence loop, and evidence-aware practice objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "capabilityPlanes",
    "patternIntelligenceLoop",
    "passportScales",
    "patterns",
    "drills",
    "assessments",
    "protocols"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "updated",
        "canonicalNamespace",
        "practitionerBoundary",
        "provenance"
      ],
      "properties": {
        "version": {
          "const": "0.2.0"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "deprecated"
          ]
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "canonicalNamespace": {
          "const": "HMP"
        },
        "practitionerBoundary": {
          "type": "string",
          "minLength": 20
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "capabilityPlanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/capabilityPlane"
      }
    },
    "patternIntelligenceLoop": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/loopStage"
      }
    },
    "passportScales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "field",
        "transfer",
        "rights"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/scalePoint"
          }
        },
        "field": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/scalePoint"
          }
        },
        "transfer": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/scalePoint"
          }
        },
        "rights": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/scalePoint"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "drills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/drill"
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/protocol"
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planeIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HMP-CAP-001",
          "HMP-CAP-002",
          "HMP-CAP-003",
          "HMP-CAP-004",
          "HMP-CAP-005"
        ]
      }
    },
    "scalePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "definition"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "definition": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "passport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "field",
        "transfer",
        "rights",
        "rightsScope"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "field": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3",
            "F4"
          ]
        },
        "transfer": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ]
        },
        "rights": {
          "enum": [
            "R-GREEN",
            "R-RESTRICTED",
            "R-PERMISSION",
            "R-PROHIBITED"
          ]
        },
        "rightsScope": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "claim",
        "scope",
        "claimLocator",
        "publicationStatus"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^HMP-SRC-[0-9]{3}$"
        },
        "claim": {
          "type": "string",
          "minLength": 12
        },
        "scope": {
          "type": "string",
          "minLength": 12
        },
        "claimLocator": {
          "$ref": "#/$defs/claimLocator"
        },
        "publicationStatus": {
          "enum": [
            "hold",
            "publishable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claimLocator": {
                "properties": {
                  "status": {
                    "const": "hold"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              }
            },
            "required": [
              "claimLocator"
            ]
          },
          "then": {
            "properties": {
              "publicationStatus": {
                "const": "hold"
              }
            }
          }
        }
      ]
    },
    "capabilityPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "scope",
        "outcomes",
        "exclusions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-CAP-[0-9]{3}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "scope": {
          "type": "string",
          "minLength": 20
        },
        "outcomes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "exclusions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "loopStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "verb",
        "question",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-LOOP-[0-9]{3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "verb": {
          "type": "string",
          "minLength": 3
        },
        "question": {
          "type": "string",
          "minLength": 8
        },
        "output": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "planes",
        "contexts",
        "triggerSignals",
        "invariant",
        "humanMoves",
        "aiMoves",
        "authority",
        "evidenceBasis",
        "metrics",
        "failureModes",
        "recovery",
        "passport",
        "lastReviewed",
        "nextValidation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-PAT-[0-9]{3}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "planes": {
          "$ref": "#/$defs/planeIdArray"
        },
        "contexts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "triggerSignals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "invariant": {
          "type": "string",
          "minLength": 20
        },
        "humanMoves": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "aiMoves": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "humanOwns",
            "aiMay",
            "aiMustNot"
          ],
          "properties": {
            "humanOwns": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "aiMay": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "aiMustNot": {
              "$ref": "#/$defs/nonEmptyStringArray"
            }
          }
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "metrics": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "failureModes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "recovery": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "passport": {
          "$ref": "#/$defs/passport"
        },
        "lastReviewed": {
          "type": "string",
          "format": "date"
        },
        "nextValidation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "patternIds",
        "purpose",
        "durationMinutes",
        "steps",
        "scoring",
        "stopConditions",
        "evidenceBasis",
        "passport",
        "lastReviewed",
        "nextValidation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-DRL-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "patternIds": {
          "$ref": "#/$defs/patternIdArray"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "steps": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "scoring": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stopConditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "passport": {
          "$ref": "#/$defs/passport"
        },
        "lastReviewed": {
          "type": "string",
          "format": "date"
        },
        "nextValidation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "patternIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^HMP-PAT-[0-9]{3}$"
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "patternIds",
        "purpose",
        "items",
        "interpretation",
        "limitations",
        "evidenceBasis",
        "passport",
        "lastReviewed",
        "nextValidation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-ASM-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "patternIds": {
          "$ref": "#/$defs/patternIdArray"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "behavior",
              "score0",
              "score1",
              "score2"
            ],
            "properties": {
              "behavior": {
                "type": "string",
                "minLength": 8
              },
              "score0": {
                "type": "string",
                "minLength": 5
              },
              "score1": {
                "type": "string",
                "minLength": 5
              },
              "score2": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "interpretation": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "passport": {
          "$ref": "#/$defs/passport"
        },
        "lastReviewed": {
          "type": "string",
          "format": "date"
        },
        "nextValidation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "patternIds",
        "purpose",
        "roles",
        "sequence",
        "authorityGates",
        "requiredLogs",
        "exceptionPolicy",
        "evidenceBasis",
        "passport",
        "lastReviewed",
        "nextValidation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HMP-PRT-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "patternIds": {
          "$ref": "#/$defs/patternIdArray"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "roles": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "sequence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "authorityGates": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "requiredLogs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "exceptionPolicy": {
          "type": "string",
          "minLength": 20
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "passport": {
          "$ref": "#/$defs/passport"
        },
        "lastReviewed": {
          "type": "string",
          "format": "date"
        },
        "nextValidation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullRequest",
        "generation",
        "repair",
        "curation",
        "review"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://"
        },
        "pullRequest": {
          "type": "string",
          "pattern": "^https://github\\.com/.+/pull/[0-9]+$"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "generator",
            "firstCommit",
            "recordedAt"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 10
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "firstCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "recordedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "generator",
            "inputCommit",
            "recordedAt"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 10
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "inputCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "recordedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "curation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "actor",
            "requiredRole",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved"
              ]
            },
            "actor": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "requiredRole": {
              "type": "string",
              "minLength": 8
            },
            "note": {
              "type": "string",
              "minLength": 20
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "actor": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "actor",
            "requiredRole",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved"
              ]
            },
            "actor": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "requiredRole": {
              "type": "string",
              "minLength": 8
            },
            "note": {
              "type": "string",
              "minLength": 20
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "actor": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "claimLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "locator",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "hold"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "hold"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
