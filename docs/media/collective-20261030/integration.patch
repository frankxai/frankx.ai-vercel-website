@@ -0,0 +1,96 @@
+import { readFile, writeFile, rename, realpath } from 'node:fs/promises'
+import { resolve, relative, isAbsolute, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { createHash } from 'node:crypto'
+import { canPublish, isPublicRendition, PUBLIC_BLOB_HOST } from '../../lib/media/collective-policy.mjs'
+
+export async function verifiedFile(root, file) {
+  if (!file || typeof file.path !== 'string' || !Number.isSafeInteger(file.bytes) ||
+      file.bytes < 1 || file.bytes > 32 * 1024 * 1024) throw new Error('Invalid file record')
+  const base = await realpath(root)
+  const path = await realpath(resolve(base, file.path))
+  const rel = relative(base, path)
+  if (rel.startsWith('..') || isAbsolute(rel)) throw new Error('File escapes the packet')
+  const bytes = await readFile(path)
+  const digest = createHash('sha256').update(bytes).digest('hex')
+  if (digest !== file.sha256 || bytes.length !== file.bytes) throw new Error('Byte/checksum mismatch: ' + file.path)
+  const webp = bytes.subarray(0, 4).toString() === 'RIFF' && bytes.subarray(8, 12).toString() === 'WEBP'
+  const png = bytes.subarray(0, 8).equals(Buffer.from([137,80,78,71,13,10,26,10]))
+  if (!(file.mime === 'image/webp' && webp) && !(file.mime === 'image/png' && png)) throw new Error('MIME signature mismatch')
+  return bytes
+}
+export async function plan(packet, root, mode = 'plan') {
+  if (packet?.schema_version !== 1 || !Array.isArray(packet.assets) || packet.assets.length > 50) throw new Error('Invalid packet')
+  const ids = new Set()
+  const items = []
+  for (const asset of packet.assets) {
+    if (!/^[a-z0-9_]+$/.test(asset.asset_id ?? '') || !/^[a-z0-9_]+$/.test(asset.version_id ?? '') ||
+        ids.has(asset.asset_id)) throw new Error('Invalid or duplicate identity')
+    ids.add(asset.asset_id)
+    const file = mode === 'private' ? asset.master : asset.web
+    await verifiedFile(root, file)
+    if (mode === 'public' && !canPublish(asset)) throw new Error('No source-bound public approval: ' + asset.asset_id)
+    if (!Array.isArray(asset.placements) || !asset.placements.length ||
+        asset.placements.some(p => typeof p !== 'string' || !/^[a-z0-9_.-]+$/.test(p))) throw new Error('Invalid placement')
+    items.push({asset, file, key: ['frankx', asset.asset_id, asset.version_id,
+      mode === 'private' ? 'master' : 'web', file.sha256 + (file.mime === 'image/png' ? '.png' : '.webp')].join('/')})
+  }
+  return items
+}
+async function main() {
+  const args = process.argv.slice(2)
+  const root = resolve(args.find(v => !v.startsWith('--')) ?? '.')
+  const mode = args.includes('--publish') ? 'public' : args.includes('--upload-private') ? 'private' : 'plan'
+  const packet = JSON.parse(await readFile(resolve(root, 'asset-register.json'), 'utf8'))
+  // Validate the complete batch before the first remote write.
+  const items = await plan(packet, root, mode)
+  if (mode === 'plan') {
+    console.log(JSON.stringify({mode, assets: items.length, bytes: items.reduce((n, x) => n + x.file.bytes, 0),
+      publishable: items.filter(x => canPublish(x.asset)).length, writes: 0}, null, 2))
+    return
+  }
+  const token = process.env[mode === 'private' ? 'BLOB_PRIVATE_READ_WRITE_TOKEN' : 'BLOB_READ_WRITE_TOKEN']
+  if (!token) throw new Error('Missing authorized ' + mode + ' Blob publisher credential')
+  const {put} = await import('@vercel/blob')
+  const target = resolve(root, 'implementation/data/media/collective-approved.json')
+  const existing = JSON.parse(await readFile(target, 'utf8'))
+  if (existing.schema_version !== 1 || typeof existing.placements !== 'object' || !existing.placements) throw new Error('Invalid existing manifest')
+  const placements = {...existing.placements}
+  const journalPath = resolve(root, 'upload-journal.json')
+  let journal = []
