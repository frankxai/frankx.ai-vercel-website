+import type { Metadata } from 'next'
+import { notFound } from 'next/navigation'
+import manifest from '@/data/media/collective-approved.json'
+import { publicPlacements } from '@/lib/media/collective-policy.mjs'
+import CollectiveGallery from './CollectiveGallery'
+
+export const metadata: Metadata = {
+  title: 'The collective workshop | FrankX',
+  description: 'Original character studies about building, making and keeping useful work.',
+  robots: { index: false, follow: false },
+}
+const stories = [
+  { slug: 'cast', key: 'cast', title: 'The model garden', category: 'Cast', copy: 'Seven original candidates, each with a different way of working.' },
+  { slug: 'bridge', key: 'build', title: 'A bridge made together', category: 'Build', copy: 'Frank and Brio repair the crossing. Sprout brings the seedlings through.' },
+  { slug: 'film-room', key: 'create', title: 'The moving-image workshop', category: 'Create', copy: 'Pico shapes the waves. Reel frames the shot. Omni gathers the sequence.' },
+  { slug: 'field-kit', key: 'mobile', title: 'The pocket expedition', category: 'Discover', copy: 'A shared discovery becomes something to carry home.' },
+  { slug: 'living-archive', key: 'library', title: 'The living archive', category: 'Learn', copy: 'A found image gets a place in the collection.' },
+]
+export default function CollectivePage() {
+  const approved = publicPlacements(manifest)
+  const assets = stories.flatMap(story => {
+    const image = approved['frankx.design-lab.collective.' + story.key]
+    return image ? [{...story, image}] : []
+  })
+  // noindex is not privacy. A public render sees approved imagery only.
+  if (!assets.length && process.env.NODE_ENV === 'production') notFound()
+  return <CollectiveGallery assets={assets} />
+}
+
