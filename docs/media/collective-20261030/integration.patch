+'use client'
+
+import { useRef, useState } from 'react'
+import Image from 'next/image'
+import Link from 'next/link'
+import type { PublicRendition } from '@/lib/media/collective-policy.mjs'
+import { ScrollScene } from '@/components/motion/ScrollScene'
+import styles from './collective.module.css'
+
+type Study = { slug: string; key: string; title: string; category: string; copy: string; image: PublicRendition }
+export default function CollectiveGallery({assets}: {assets: Study[]}) {
+  const [filter, setFilter] = useState('All')
+  const [selected, setSelected] = useState<Study | null>(null)
+  const dialog = useRef<HTMLDialogElement>(null)
+  const filters = ['All', ...new Set(assets.map(asset => asset.category))]
+  const visible = filter === 'All' ? assets : assets.filter(asset => asset.category === filter)
+  const hero = assets.find(asset => asset.slug === 'bridge') ?? assets[0]
+  function inspect(study: Study) { setSelected(study); dialog.current?.showModal() }
+  return (
+    <main className={styles.root}>
+      <div className={styles.top}><Link href="/design-lab">Back to Design Lab</Link><span>FrankX / Character studies</span></div>
+      <header className={styles.intro}>
+        <p className={styles.kicker}>The collective workshop</p>
+        <h1>Give the work<br />a <em>living world.</em></h1>
+        <p>Frank, the studio companions, and a new cast of makers. Each scene gives them a job, an object, and a reason to work together.</p>
+        <a className={styles.primary} href="#studies">Explore the studies <span aria-hidden="true">↗</span></a>
+      </header>
+      {hero && <ScrollScene pin={false} start="top bottom" end="bottom top" scrub={0.6}
+        className={styles.hero}
+        timeline={(timeline, root) => {
+          const art = root.querySelector('[data-collective-art]')
+          if (art) timeline.fromTo(art, {yPercent: -2}, {yPercent: 2, ease: 'none'})
+        }}>
+        <div data-collective-art>
+          <Image src={hero.image.url} alt={hero.image.alt} width={hero.image.width} height={hero.image.height}
+            sizes="(max-width: 768px) 100vw, 1200px" priority className={styles.art} />
+        </div>
+        <p className={styles.caption}>Original scene study. The characters are visual interpretations.</p>
+      </ScrollScene>}
+      <section id="studies" className={styles.studies} aria-labelledby="studies-title">
+        <div className={styles.sectionHeading}><h2 id="studies-title">A different kind of company.</h2><p>Build. Make. Discover. Keep.</p></div>
+        <div className={styles.filters} role="group" aria-label="Filter studies">
+          {filters.map(label => <button key={label} type="button" aria-pressed={filter === label}
+            onClick={() => setFilter(label)}>{label}</button>)}
+        </div>
+        <p className={styles.result} role="status" aria-live="polite">{visible.length} {visible.length === 1 ? 'study' : 'studies'}</p>
+        {!assets.length && <p className={styles.empty}>The artwork is in private review. Approved studies will appear here when they are ready.</p>}
+        <div className={styles.grid}>
+          {visible.map((study, i) => <article key={study.slug} className={i === 0 && filter === 'All' ? styles.feature : ''}>
+            <button type="button" className={styles.imageButton} onClick={() => inspect(study)} aria-label={'Inspect ' + study.title}>
+              <Image src={study.image.url} alt={study.image.alt} width={study.image.width} height={study.image.height}
+                sizes="(max-width: 768px) 100vw, 50vw" loading="lazy" className={styles.art} />
+            </button>
+            <div className={styles.studyCopy}><span>{study.category}</span><h3>{study.title}</h3><p>{study.copy}</p>
+              <button className={styles.textButton} type="button" onClick={() => inspect(study)}>Inspect the study <span aria-hidden="true">↗</span></button></div>
+          </article>)}
+        </div>
+      </section>
+      <section className={styles.method}><h2>The character has a job.</h2><p>Its shape should explain how it works. Its action should change something you can see. The resulting artifact should still matter when the illustration is gone.</p>
+        <Link href="/ai-architecture">Inspect the systems behind the work ↗</Link>
+      </section>
+      <dialog ref={dialog} className={styles.dialog} aria-labelledby="study-title" onClose={() => setSelected(null)}>
+        <div className={styles.dialogBar}><p>Study details</p><button autoFocus type="button" aria-label="Close study" onClick={() => dialog.current?.close()}>Close ×</button></div>
+        {selected && <><Image src={selected.image.url} alt={selected.image.alt} width={selected.image.width} height={selected.image.height}
+          sizes="90vw" className={styles.art} /><div className={styles.dialogCopy}><h2 id="study-title">{selected.title}</h2><p>{selected.copy}</p>
+          <dl><dt>Asset</dt><dd>{selected.image.asset_id}</dd><dt>Version</dt><dd>{selected.image.version_id}</dd></dl>
+          <p>Original character interpretation. This scene does not establish a connected agent or runtime.</p></div></>}
+      </dialog>
+    </main>
+  )
+}
+
