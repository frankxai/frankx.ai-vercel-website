+// Central public-delivery policy. Private records are never input to the page.
+export const PUBLIC_BLOB_HOST = 'vbmwpibfe0yzx3fd.public.blob.vercel-storage.com'
+const checksum = /^[a-f0-9]{64}$/
+const key = /^[a-z0-9_.-]+$/
+export function canPublish(asset) {
+  const approval = asset?.approval
+  return Boolean(asset && asset.status === 'approved' &&
+    asset.rights?.public_approved === true &&
+    asset.rights?.status === 'cleared' &&
+    asset.rights?.third_party_characters === false &&
+    checksum.test(asset.web?.sha256 ?? '') &&
+    approval?.source === 'control-plane-export' &&
+    typeof approval.actor === 'string' && approval.actor.trim() &&
+    typeof approval.evidence_uri === 'string' && /^https:\/\//.test(approval.evidence_uri) &&
+    Number.isFinite(Date.parse(approval.at)) &&
+    approval.web_sha256 === asset.web.sha256)
+}
+export function isPublicRendition(value) {
+  if (!value || typeof value !== 'object') return false
+  let url
+  try { url = new URL(value.url) } catch { return false }
+  return value.status === 'published' && value.access === 'public' &&
+    value.rights_cleared === true && value.third_party_characters === false &&
+    value.approval?.source === 'control-plane-export' &&
+    typeof value.approval.actor === 'string' && Boolean(value.approval.actor.trim()) &&
+    /^https:\/\//.test(value.approval.evidence_uri ?? '') &&
+    Number.isFinite(Date.parse(value.approval.at)) &&
+    value.approval.web_sha256 === value.sha256 &&
+    url.protocol === 'https:' && url.hostname === PUBLIC_BLOB_HOST &&
+    !url.username && !url.password && !url.search && !url.hash &&
+    checksum.test(value.sha256 ?? '') && url.pathname.includes(value.sha256) &&
+    typeof value.asset_id === 'string' && key.test(value.asset_id) &&
+    typeof value.version_id === 'string' && key.test(value.version_id) &&
+    typeof value.alt === 'string' && value.alt.trim().length > 0 &&
+    Number.isInteger(value.width) && value.width > 0 &&
+    Number.isInteger(value.height) && value.height > 0
+}
+export function publicPlacements(manifest) {
+  if (manifest?.schema_version !== 1 || !manifest.placements ||
+      typeof manifest.placements !== 'object' || Array.isArray(manifest.placements)) return {}
+  return Object.fromEntries(Object.entries(manifest.placements)
+    .filter(([placement, value]) => key.test(placement) && isPublicRendition(value)))
+}
+
