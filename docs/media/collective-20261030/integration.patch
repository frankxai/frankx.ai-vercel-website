+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {mkdtemp, writeFile, symlink, rm} from 'node:fs/promises'
+import {tmpdir} from 'node:os'
+import {join} from 'node:path'
+import {createHash} from 'node:crypto'
+import {canPublish, publicPlacements, PUBLIC_BLOB_HOST} from '../../lib/media/collective-policy.mjs'
+import {verifiedFile, plan} from './publish-collective.mjs'
+const hash = 'a'.repeat(64)
+const approval = {source:'control-plane-export', actor:'named-reviewer', at:'2026-10-30T12:00:00Z',
+  evidence_uri:'https://review.example/receipt', web_sha256:hash}
+const asset = () => ({asset_id:'ast_example',version_id:'ver_example',status:'approved',
+  rights:{public_approved:true,status:'cleared',third_party_characters:false},approval:{...approval},
+  web:{sha256:hash}})
+const rendition = () => ({asset_id:'ast_example',version_id:'ver_example',status:'published',
+  access:'public',rights_cleared:true,third_party_characters:false,approval:{...approval},
+  url:'https://' + PUBLIC_BLOB_HOST + '/frankx/ast_example/ver_example/web/' + hash + '.webp',
+  sha256:hash,width:1672,height:941,alt:'A source-backed original scene.'})
+test('a draft or guest character cannot be promoted; approval binds exact web bytes', () => {
+  assert.equal(canPublish(asset()),true)
+  for(const change of [
+    {status:'review'}, {approval:null}, {approval:{...approval,web_sha256:'b'.repeat(64)}},
+    {rights:{public_approved:true,status:'cleared',third_party_characters:true}},
+    {rights:{public_approved:true,status:'pending',third_party_characters:false}}
+  ]) assert.equal(canPublish({...asset(),...change}),false)
+})
+test('render selection rejects private, stale, revoked, signed and foreign URLs', () => {
+  assert.equal(Object.keys(publicPlacements({schema_version:1,placements:{hero:rendition()}})).length,1)
+  for(const change of [
+    {access:'private'}, {status:'superseded'}, {rights_cleared:false},
+    {url:'https://untrusted.example/' + hash + '.webp'},
+    {url:rendition().url+'?token=private'}, {approval:{...approval,web_sha256:'b'.repeat(64)}},
+    {alt:''}, {width:0}, {third_party_characters:true},
+    {url:rendition().url.replace(hash,'unversioned')}
+  ]) assert.deepEqual(publicPlacements({schema_version:1,placements:{hero:{...rendition(),...change}}}),{})
+  assert.deepEqual(publicPlacements({schema_version:2,placements:{hero:rendition()}}),{})
+  assert.deepEqual(publicPlacements(null),{})
+})
+test('ingest verifies bytes and rejects escape paths and disguised images', async () => {
+  const root=await mkdtemp(join(tmpdir(),'collective-test-'))
+  try {
+    const bytes=Buffer.from([137,80,78,71,13,10,26,10,1,2,3,4])
+    await writeFile(join(root,'image.png'),bytes)
+    const file={path:'image.png',bytes:bytes.length,mime:'image/png',sha256:createHash('sha256').update(bytes).digest('hex')}
+    assert.deepEqual(await verifiedFile(root,file),bytes)
+    await assert.rejects(verifiedFile(root,{...file,sha256:'b'.repeat(64)}),/checksum/)
+    await assert.rejects(verifiedFile(root,{...file,mime:'image/webp'}),/MIME/)
+    await writeFile(join(root,'fake.webp'),'this is not an image')
+    const fake=Buffer.from('this is not an image')
+    await assert.rejects(verifiedFile(root,{path:'fake.webp',bytes:fake.length,mime:'image/webp',sha256:createHash('sha256').update(fake).digest('hex')}),/MIME/)
+    await symlink('/etc/hosts',join(root,'escape.png'))
+    await assert.rejects(verifiedFile(root,{...file,path:'escape.png'}),/escapes/)
+    const a={...asset(),web:file,master:file,placements:['test.hero']}
+    assert.equal((await plan({schema_version:1,assets:[a]},root,'plan')).length,1)
+    await assert.rejects(plan({schema_version:1,assets:[a,a]},root,'plan'),/duplicate/)
+    await assert.rejects(plan({schema_version:1,assets:[a]},root,'public'),/approval/)
+  } finally {await rm(root,{recursive:true,force:true})}
+})
+
