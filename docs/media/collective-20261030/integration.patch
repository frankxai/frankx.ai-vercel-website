+export type PublicRendition = {
+  asset_id: string; version_id: string; url: string; width: number; height: number;
+  alt: string; sha256: string; status: 'published'; access: 'public';
+  rights_cleared: true; third_party_characters: false;
+  approval: { source: 'control-plane-export'; actor: string; at: string; evidence_uri: string; web_sha256: string };
+}
+export const PUBLIC_BLOB_HOST: string
+export function canPublish(asset: unknown): boolean
+export function isPublicRendition(value: unknown): value is PublicRendition
+export function publicPlacements(manifest: unknown): Record<string, PublicRendition>
+
